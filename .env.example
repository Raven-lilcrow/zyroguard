# Telegram bot token from @BotFather
BOT_TOKEN=

# Claude API key for the gray-zone judge. Leave empty to run rules-only.
ANTHROPIC_API_KEY=
# Optional. The URL of an Anthropic-compatible gateway. Leave empty for api.anthropic.com
ANTHROPIC_BASE_URL=
JUDGE_MODEL=claude-opus-5
JUDGE_EFFORT=low
# Effort for answering member questions (same model as the judge): low, medium or high
ASSISTANT_EFFORT=medium

# Contact the admin button. Messages go to the OWNER_IDS account on Telegram and,
# if the webhook is set, by email through n8n (import n8n/ZyroGuard-Contact.json).
CONTACT_EMAIL=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional private activity record: groups added or refused, access changes, what admins did
# and changed, and a daily summary, sent to a webhook (for example an n8n workflow that writes
# a Google Sheet) as Google Sheets API calls. Every event is kept in the database either way.
OWNER_LEDGER_URL=
OWNER_LEDGER_SECRET=

# The bot owner's Telegram user id (one person). /id in any chat prints it.
OWNER_IDS=

# Groups the bot always serves, comma separated. Groups added from
# the OWNER_IDS account or by a user with access are served too; the bot leaves any other group.
ALLOWED_CHAT_IDS=

# Private group/channel that receives action reports (bot must be a member).
MODLOG_CHAT_ID=

# Optional n8n webhook for the mod-log workflow, and its shared header secret. Leave the URL empty
# without n8n. With n8n: N8N_EVENT_URL=http://n8n:5678/webhook/zyroguard-event
# The secret also unlocks the internal /stats endpoint, which is off while it is empty.
N8N_EVENT_URL=
N8N_EVENT_SECRET=

# shadow only reports, enforce acts. Per-group /mode overrides this default.
MODE=shadow
CAS_ENABLED=true
LOG_LEVEL=INFO
DB_PATH=/data/zyroguard.db
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
